# QTestHub production environment template (Tier 0 / ADR-052).
#
# Copy this file to `.env` and replace every CHANGE_ME value with a real,
# randomly generated secret before running docker-compose.prod.yml.
# NEVER commit the resulting .env file -- it is already gitignored.
#
# This file contains ONLY placeholders. No development or real credentials
# are included here.

# --- Database -----------------------------------------------------------
POSTGRES_USER=qtesthub
POSTGRES_PASSWORD=CHANGE_ME_generate_a_long_random_password
POSTGRES_DB=qtesthub
# Password for the least-privilege runtime app role (ADR-006). Must stay
# stable across deployments/restarts -- the app connects as this role, not
# POSTGRES_USER, at runtime.
APP_DB_PASSWORD=CHANGE_ME_generate_a_long_random_password

# --- Application ----------------------------------------------------------
ENVIRONMENT=production
LOG_LEVEL=INFO

# Fernet key (44 base64 chars) encrypting tenant AI provider credentials at
# rest (ADR-045). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing this after tenants have saved AI credentials makes those
# credentials undecryptable -- back it up securely, do not lose it.
AI_CREDENTIAL_ENCRYPTION_KEY=CHANGE_ME_generate_with_fernet_generate_key

# Exact origin(s) the frontend is served from, as a JSON array string, e.g.
# '["https://app.example.com"]'. Must NOT be "*" in production.
CORS_ALLOW_ORIGINS=["https://CHANGE_ME.example.com"]

# --- MFA / notification email delivery (ADR-032 / ADR-051) ---------------
# "simulated" returns/logs the code instead of emailing it -- never use
# "real" without SMTP configured below for anything beyond a smoke test.
MFA_DELIVERY_MODE=real
NOTIFICATION_EMAIL_DELIVERY_MODE=real
SMTP_HOST=smtp.CHANGE_ME.example.com
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM_EMAIL=no-reply@CHANGE_ME.example.com

# --- Error monitoring (Tier 0 / ADR-052) ----------------------------------
# Leave blank to disable Sentry entirely (default, safe for a first deploy).
SENTRY_DSN=

# --- Connection pooling (Tier 0 / ADR-052) --------------------------------
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- Frontend build-time ---------------------------------------------------
# Baked into the static JS bundle at `docker compose build` time -- if your
# API is served at a different path/host than the same origin's /api/v1,
# set this before building.
VITE_API_BASE_URL=/api/v1

# --- Reverse proxy (Tier 0 / ADR-052) -------------------------------------
HTTP_PORT=80
HTTPS_PORT=443
# Host directory containing fullchain.pem/privkey.pem -- see
# deploy/nginx/reverse-proxy.conf and docs/PRODUCTION_DEPLOYMENT_GUIDE.md.
TLS_CERT_DIR=./deploy/nginx/certs

# --- Backup scripts (scripts/db_backup.sh, db_restore.sh) -----------------
# These are typically exported separately in the backup cron job's own
# environment, not sourced from this .env, since they usually run on a
# different host than the app containers. Listed here for completeness.
# POSTGRES_HOST=db.CHANGE_ME.example.com
# POSTGRES_PORT=5432
# PGPASSWORD=CHANGE_ME
# BACKUP_DIR=/var/backups/qtesthub
# BACKUP_RETENTION_DAYS=14
# ATTACHMENTS_DIR=/var/lib/qtesthub/attachments
