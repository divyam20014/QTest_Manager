DATABASE_URL=postgresql+psycopg://qtesthub:qtesthub@localhost:5432/qtesthub
# Only needed when DATABASE_URL points at the restricted qtesthub_app role
# (as in docker-compose) and Alembic needs owner privileges to run migrations.
# MIGRATION_DATABASE_URL=postgresql+psycopg://qtesthub:qtesthub@localhost:5432/qtesthub
ENVIRONMENT=development
MFA_DELIVERY_MODE=simulated
