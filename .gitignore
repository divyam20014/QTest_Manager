# Root (docker-compose variable substitution)
/.env
.env.*
!.env.example

# TLS certificates/keys -- never commit real ones (deploy/nginx/certs/ is
# meant to be populated at deploy time, e.g. from certbot's output).
*.pem
*.key
*.crt
*.p12
deploy/nginx/certs/*
!deploy/nginx/certs/.gitkeep

# Backend
backend/.venv/
backend/__pycache__/
backend/**/__pycache__/
backend/.pytest_cache/
backend/.mypy_cache/
backend/.ruff_cache/
backend/.env
backend/tests/_tmp_attachments/

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/playwright-report/
frontend/test-results/

# OS / editor
.DS_Store
*.log
