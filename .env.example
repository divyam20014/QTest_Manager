# Copy to .env (gitignored) before running `docker compose up`.
# Used only for docker-compose variable substitution -- the backend and
# frontend containers read their own settings from the `environment:`
# blocks in docker-compose.yml, which are populated from these values.

POSTGRES_USER=qtesthub
# Change this for any shared/non-local environment.
POSTGRES_PASSWORD=change_me_dev_only
POSTGRES_DB=qtesthub

# Password for the least-privilege qtesthub_app runtime role (ADR-006).
# Must match the value used when migrations were last run -- see
# backend/alembic/versions/c1d2e3f4a5b6_parameterize_app_role_password.py.
APP_DB_PASSWORD=change_me_dev_only

ENVIRONMENT=development
LOG_LEVEL=INFO
MFA_DELIVERY_MODE=simulated
VITE_API_BASE_URL=http://localhost:8000/api/v1
