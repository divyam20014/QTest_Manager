# Production image (Tier 0 / ADR-052). The default frontend/Dockerfile stays
# a dev-server image for docker-compose.yml's fast-rebuild workflow; this is
# a real multi-stage build producing a static artifact, used only by
# docker-compose.prod.yml.

FROM node:22-alpine AS builder
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
# VITE_API_BASE_URL is baked in at build time (Vite env vars are compiled
# into the static bundle, unlike the backend's runtime env vars) -- set it
# as a build arg when building this image for a specific deployment target.
ARG VITE_API_BASE_URL=/api/v1
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
HEALTHCHECK --interval=10s --timeout=5s --retries=5 --start-period=5s \
    CMD wget --quiet --spider http://127.0.0.1:80/ || exit 1
